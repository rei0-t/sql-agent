# 复制为 .env 后按需修改。所有变量都带 SQLAGENT_ 前缀。

# ---- 服务 ----
SQLAGENT_HOST=127.0.0.1
SQLAGENT_PORT=8080
SQLAGENT_DEBUG=false

# ---- 元数据库 ----
# 本机开发默认用 SQLite，无需任何外部依赖。
# 生产建议改成 PostgreSQL：
# SQLAGENT_DATABASE_URL=postgresql+asyncpg://sqlagent:sqlagent@127.0.0.1:5432/sqlagent
SQLAGENT_DATABASE_URL=
SQLAGENT_DATA_DIR=./data

# 是否开放自助注册（每个新用户自动获得独立工作空间）。对外开放设为 true；
# 设为 false 时只有初始化创建的管理员能登录。
SQLAGENT_ALLOW_REGISTRATION=true

# ---- 安全（部署前必须替换）----
# 用于签发登录令牌 + 加密数据源口令。更换后已存的数据源口令将无法解密。
SQLAGENT_SECRET_KEY=change-me-to-a-long-random-string
SQLAGENT_ACCESS_TOKEN_TTL_MINUTES=720

# ---- 首次启动创建的管理员 ----
SQLAGENT_ADMIN_USERNAME=admin
SQLAGENT_ADMIN_PASSWORD=sqlagent123
# 会话 cookie 是否只走 HTTPS（生产环境务必打开）
SQLAGENT_COOKIE_SECURE=false

# ---- 目标库连接 ----
SQLAGENT_CONNECT_TIMEOUT=5
SQLAGENT_QUERY_TIMEOUT=10

# ---- 模型（可选）----
# 推荐做法：登录后在「设置」页填 Base URL / 模型 / Key，会加密存库并优先生效。
# 这里留空即可；填了则作为默认值（界面未配置时回退到这里），适合团队统一部署。
SQLAGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SQLAGENT_LLM_MODEL=qwen-plus
SQLAGENT_LLM_API_KEY=
SQLAGENT_LLM_SEED=42
SQLAGENT_LLM_TIMEOUT=60
# 端点校验：默认禁止把 base_url 指向内网/本机（BYOK 的 SSRF 防护）。
# 本地跑 Ollama / vLLM 时改成 true
SQLAGENT_LLM_ALLOW_PRIVATE_HOSTS=false

# ---- 登录失败限流 ----
SQLAGENT_LOGIN_RATELIMIT_ENABLED=true
SQLAGENT_LOGIN_MAX_FAILURES_PER_IP=10
SQLAGENT_LOGIN_MAX_FAILURES_PER_USER=5
SQLAGENT_LOGIN_FAILURE_WINDOW=300

# ---- 注册限流（按成功建号计数）----
SQLAGENT_REGISTER_RATELIMIT_ENABLED=true
SQLAGENT_REGISTER_MAX_PER_IP=5
SQLAGENT_REGISTER_WINDOW=3600

# ---- 示例库与问答配额 ----
# 每个工作空间自动获得一个只读的演示数据源（同一个文件，多个引用）
SQLAGENT_DEMO_DATASOURCE=true
# 用公共模型 Key 对外开放时，这是唯一防刷的手段（按工作空间计）
SQLAGENT_CHAT_RATELIMIT_ENABLED=true
SQLAGENT_CHAT_MAX_PER_HOUR=60

# ---- SQLite 文件上传 ----
# 关掉之后前端「上传文件」入口会被拒（403），只保留手填服务器路径
SQLAGENT_ALLOW_UPLOAD=true
SQLAGENT_UPLOAD_MAX_MB_PER_FILE=50
SQLAGENT_UPLOAD_MAX_MB_PER_WORKSPACE=200
# 全站上限：开放注册时防止被塞满磁盘
SQLAGENT_UPLOAD_MAX_MB_TOTAL=2048

# ---- 注入防护 ----
# 严格表白名单：只允许模型"看过"的表。会误杀合法的跨表查询，敏感库再开。
SQLAGENT_STRICT_TABLE_ALLOWLIST=false

# ---- 只读通道 ----
SQLAGENT_READ_MAX_ROWS=200
SQLAGENT_MAX_REPAIR=3
# 语义层：指标口径、同义词、示例 SQL（模板见 docs/semantics.example.yaml）
SQLAGENT_SEMANTICS_PATH=./data/semantics.yaml
# 生产部署要填的值。复制到仓库根目录的 .env.prod（已被 .gitignore 忽略）
#
#   cp deploy/aliyun/.env.prod.example .env.prod

# 登录令牌 + 数据源口令加密都用它。生成：openssl rand -hex 32
# 注意：更换后已存的数据源口令与界面里的模型 Key 都无法解密
SQLAGENT_SECRET_KEY=

# 首次启动创建的管理员（登录后建议立刻在设置里确认模型）
SQLAGENT_ADMIN_USERNAME=admin
SQLAGENT_ADMIN_PASSWORD=

# 元数据库口令（compose 内部使用，不会暴露到公网）
POSTGRES_PASSWORD=

# 会话 cookie 只在 HTTPS 下发送：接入域名/证书后改成 true
# （用 IP:8080 调试时先保持 false，否则浏览器不认）
SQLAGENT_COOKIE_SECURE=false

# 镜像标签，方便回滚
IMAGE_TAG=latest

# ---- 以下通常不用改 ----
# 模型：留空 API Key 则完全以界面配置为准
SQLAGENT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SQLAGENT_LLM_MODEL=qwen-plus
SQLAGENT_LLM_API_KEY=
SQLAGENT_LLM_SEED=42
SQLAGENT_READ_MAX_ROWS=200
SQLAGENT_QUERY_TIMEOUT=10